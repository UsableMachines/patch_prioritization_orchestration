# Environment variables for Patch Prioritization & Orchestration
SECRET_KEY=change-me-to-a-random-string
DATABASE_URL=sqlite:///patch_prioritization.db

# Kindo AI Agent (required for AI features)
KINDO_API_TOKEN=
KINDO_AGENT_ID=

# Optional
PORT=5000
GUNICORN_WORKERS=2
APP_GUNICORN_TIMEOUT=120
APP_AGENT_POLL_TIMEOUT_SEC=120
SESSION_COOKIE_PATH=/
SESSION_COOKIE_SECURE=false
